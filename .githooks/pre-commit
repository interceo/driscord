#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

STAGED=()
while IFS= read -r -d '' path; do
    case "$path" in
        core/*|backend/signaling_server/*|client-qt/*)
            case "$path" in
                *.cpp|*.hpp|*.h) STAGED+=("$path") ;;
            esac
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if (( ${#STAGED[@]} == 0 )); then
    exit 0
fi

for f in "${STAGED[@]}"; do
    if ! git diff --quiet -- "$f"; then
        echo "ERROR: $f has staged and unstaged changes; stage or stash it before formatting." >&2
        exit 1
    fi
done

for f in "${STAGED[@]}"; do
    clang-format -i "$ROOT/$f"
    git add -- "$ROOT/$f"
done
